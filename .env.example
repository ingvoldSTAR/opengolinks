# Copy to .env for local use. In production, set these in your host's environment settings.
# Never commit real values.

# Postgres connection string, for any Postgres. Required in production.
# Leave empty locally: an embedded Postgres is created in ./.data
# Use sslmode=no-verify in the string only for a server with a self-signed certificate.
DATABASE_URL=

# Optional. A pooled connection string (for example from a connection pooler). Wins over DATABASE_URL when set.
DATABASE_URL_POOLED=

# Optional. Directory for the embedded database. Lets a production build run locally without DATABASE_URL.
PGLITE_DIR=

# Signs the session cookie. Required in production, at least 32 characters (openssl rand -hex 32).
SESSION_SECRET=

# Comma separated hosts allowed to serve /admin, for example go.example.com.
# Required in production: while empty, /admin answers 404 everywhere. Locally, empty allows every host.
# The first entry is also used for sign-in redirects and as the default CNAME target.
ADMIN_HOSTS=

# Comma separated emails that are always admins (created on startup if missing). This is how the first person
# gets in: sign in with a provider whose VERIFIED email is one of these, then invite everyone else from the People page.
ADMIN_EMAILS=

# Optional. A shared password for /admin, at least 12 characters. It is not tied to a person and counts as an admin,
# so use it to get started (or locally) and remove it once people have their own accounts. Without it you need a
# sign-in provider below.
ADMIN_PASSWORD=

# Optional. Each pair switches on a "Continue with ..." button. You create the app at the provider yourself;
# the callback address is https://<admin host>/api/auth/<provider>/callback (http://localhost:3000/... locally).
# GitHub: github.com/settings/developers, create an OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Google Cloud console, an OAuth client ID of type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft 365 (one tenant only): Microsoft Entra admin center, an app registration for this organisation only.
# Tenant and client IDs are GUIDs: copy them from the app's Overview page.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional. The Microsoft 365 mailbox that sends invitation emails, through Microsoft Graph with the Microsoft app above.
# Needs the Mail.Send application permission with admin consent, limited to this one mailbox. Without it, an
# invitation gives you a link to send yourself.
MAIL_FROM=

# Optional. The name shown in the admin, in invitation emails and to AI agents. Defaults to opengolinks.
APP_NAME=

# Optional. Host shown as the CNAME value on the Domains page. Defaults to the first ADMIN_HOSTS entry.
CNAME_TARGET=

# Optional. IANA time zone that decides where a day starts in the statistics. Defaults to UTC.
TIMEZONE=

# Test only. Base URL the Rebrandly importer calls, so tests can use a local fake of the API.
# Leave it unset: the importer then talks to the real service.
# REBRANDLY_API_BASE=
